# ============================================
# Synkra AIOX Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase (database, auth, storage)
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOX Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=2.2.0

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below

# --------------------------------------------
# IcognitoChat Application
# --------------------------------------------

# Senha mestre para criar salas privadas (admin)
MASTER_PASSWORD=change_me_in_production

# Segredo para assinar sessões iron-session (mín. 32 caracteres)
SESSION_SECRET=change_me_to_a_random_32_char_secret

# Porta do servidor (padrão: 3000)
PORT=3000

# Path do banco SQLite (Railway Volume: /data/icognitochat.db)
# Em dev local, deixe em branco — usa ./data/icognitochat.db por padrão
# No Railway: configure o Volume montado em /data e defina DB_PATH=/data/icognitochat.db
DB_PATH=

# URL base da aplicação (usado pelo next-pwa e CORS em produção)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Duração máxima da sessão em dias (padrão: 7)
SESSION_TTL_DAYS=7

# Tempo máximo de inatividade em horas antes de expirar a sessão (padrão: 24)
SESSION_INACTIVE_HOURS=24

# TTL de mensagens em horas — mensagens mais antigas são deletadas automaticamente (0 = desabilitado)
MESSAGE_TTL_HOURS=24

# TTL de imagens em horas — arquivos de imagem mais antigos são deletados do disco automaticamente (0 = desabilitado)
IMAGE_TTL_HOURS=48

# Nível de log do servidor (debug | info | warn | error) — padrão: debug em dev, info em prod
LOG_LEVEL=info
